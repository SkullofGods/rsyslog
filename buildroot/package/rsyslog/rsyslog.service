[Unit]
Description=System Logging Service
Documentation=man:rsyslogd(8)
Documentation=https://www.rsyslog.com/doc/
# WBOS: rsyslog owns /dev/log directly (this package masks journald's
# systemd-journald-dev-log.socket) so the daemons' RFC 5424 frames reach
# rsyslog intact instead of being re-framed by journald. Hence NO
# 'Requires=syslog.socket' — imuxsock binds /dev/log itself.
After=systemd-journald.service

[Service]
# Type=notify needs rsyslog built with systemd support (sd_notify), which is
# enabled when BR2_INIT_SYSTEMD + BR2_PACKAGE_RSYSLOG_EXTRA_PLUGINS are set.
Type=notify
ExecStart=/usr/sbin/rsyslogd -n -iNONE
StandardOutput=null
Restart=on-failure

# Increase the default a bit in order to allow many simultaneous
# files to be monitored, we might need a lot of fds.
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
Alias=syslog.service
