config BR2_PACKAGE_RSYSLOG
	bool "rsyslog"
	depends on BR2_USE_MMU # fork()
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_USE_WCHAR
	select BR2_PACKAGE_LIBESTR
	select BR2_PACKAGE_LIBFASTJSON
	select BR2_PACKAGE_LIBLOGGING
	select BR2_PACKAGE_ZLIB
	help
	  Rsyslog is an enhanced multi-threaded syslogd. Built from the WBOS
	  fork with the WBOS RFC 5424 receiver config installed, so the
	  structured log stream from the WBOS daemons (asic_manager,
	  config_manager, route_manager, route_server, flow_manager) is
	  received on /dev/log and routed into /var/log/wbos/. Uses only stock
	  modules (imuxsock, imklog, the built-in rfc5424 parser).

	  https://www.rsyslog.com/

if BR2_PACKAGE_RSYSLOG

config BR2_PACKAGE_RSYSLOG_EXTRA_PLUGINS
	bool "extra plugins"
	help
	  Build and install the full set of optional input/output/parser/
	  modify plugins (imfile, impstats, omprog, mmjsonparse, mmpstrucdata,
	  ...) and the dependency-gated ones (gnutls, hiredis, mysql, ...). The
	  WBOS log pipeline does not require any of these.

endif

comment "rsyslog needs a toolchain w/ threads, wchar"
	depends on BR2_USE_MMU
	depends on !BR2_TOOLCHAIN_HAS_THREADS || !BR2_USE_WCHAR
